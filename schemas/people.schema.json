{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris-research-lab.github.io/schemas/people.schema.json",
  "title": "IRIS Lab people",
  "description": "Repository-owned people served at /data/people.json. Keep public IDs and URLs stable.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "role"],
    "properties": {
      "id": { "description": "Unique, stable id: firstname-lastname in lowercase.", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "role": {
        "description": "pi, postdoc, phd, ms, undergrad, or visitor. For alumni, keep the role they held and add an 'alumni' object.",
        "enum": ["pi", "postdoc", "phd", "ms", "undergrad", "visitor"]
      },
      "start": {
        "description": "When a current student joined, as a term such as Fall 2026. Students only (phd, ms, undergrad). Pair with end. Omit both for faculty and alumni.",
        "type": "string",
        "pattern": "^(Spring|Summer|Fall|Winter) [0-9]{4}$"
      },
      "end": {
        "description": "When that student leaves, as a term such as Spring 2030, or the exact string In progress. Pair with start.",
        "type": "string",
        "pattern": "^(In progress|(Spring|Summer|Fall|Winter) [0-9]{4})$"
      },
      "title": { "description": "Optional custom subtitle shown under the name.", "type": "string" },
      "photo": {
        "description": "Absolute URL of a photo committed in this website repository, normally https://iris-research-lab.github.io/assets/images/people/<id>.jpg (square-ish, ~600px).",
        "type": "string",
        "pattern": "^https://"
      },
      "photoPosition": {
        "description": "CSS object-position for this person's round photo, two tokens such as \"center top\". Omit it to keep the default center crop.",
        "type": "string",
        "pattern": "^(left|center|right|0%|[1-9][0-9]?%|100%) (top|center|bottom|0%|[1-9][0-9]?%|100%)$"
      },
      "interests": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 5 },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "website": { "type": "string", "pattern": "^https?://" },
          "email": { "type": "string", "format": "email" },
          "scholar": { "type": "string", "pattern": "^https://scholar\\.google\\.com/" },
          "github": { "type": "string", "pattern": "^https://github\\.com/" },
          "linkedin": { "type": "string", "pattern": "^https://(www\\.)?linkedin\\.com/" },
          "orcid": { "type": "string", "pattern": "^https://orcid\\.org/" },
          "bluesky": { "type": "string", "pattern": "^https://bsky\\.app/" },
          "twitter": { "type": "string", "pattern": "^https://(twitter|x)\\.com/" }
        }
      },
      "alumni": {
        "description": "Add this once someone leaves the lab.",
        "type": "object",
        "additionalProperties": false,
        "required": ["years"],
        "properties": {
          "years": { "description": "e.g. '2026-2031'", "type": "string" },
          "now": { "description": "e.g. 'Research Scientist at Google'", "type": "string" }
        }
      }
    },
    "dependentRequired": {
      "start": ["end"],
      "end": ["start"]
    },
    "allOf": [
      {
        "if": { "required": ["start"] },
        "then": {
          "properties": {
            "role": { "enum": ["phd", "ms", "undergrad"] }
          },
          "not": { "required": ["alumni"] }
        }
      }
    ]
  }
}
